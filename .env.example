# Token dari @BotFather — jangan pernah di-commit
BOT_TOKEN=
# ID Telegram pemilik, pisahkan dengan koma; kosong = instance mode tamu saja
OWNER_IDS=
# URL Mini App (HTTPS di VPS; http://localhost:8080 untuk self-host)
WEBAPP_URL=http://localhost:8080
# Lokasi database SQLite (di volume Docker)
DB_PATH=/data/finnfinn.db
# Port HTTP di dalam container
PORT=8080
# Zona waktu untuk cap waktu log
TZ=Asia/Jakarta
# Baca struk di server: on / off
OCR=on
# 1 = lampirkan snapshot database ke laporan bulanan
BACKUP_TO_TELEGRAM=0
# 1 = tanpa autentikasi untuk peer lokal — JANGAN pernah di server publik
DEV_NO_AUTH=0
